# ── SANJHH BY AM — environment configuration ─────────────────────────────
# Copy this file to `.env` (or export the variables) before running in production.
# NEVER commit real secrets. NEVER expose these to client-side code.

PORT=3000

# Admin credentials (change these before going live!)
ADMIN_EMAIL=admin@sanjhhbyam.local
ADMIN_PASSWORD=ChangeThisPassword123!

# Session secret used to sign admin session tokens
SESSION_SECRET=generate-a-long-random-string-here

# ── Razorpay (server-side only — key secret is never sent to the browser) ──
# When these are empty the store runs in DEMO payment mode:
# online payments are simulated and clearly labelled as demo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Shipping provider (aggregator such as Shiprocket/Delhivery can be wired in) ──
SHIPPING_PROVIDER=
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
